# Lets the logged-in user configure the Aula F108 Pro without root.
#
# Only the interfaces used for configuration are opened up, never the ones
# that carry keystrokes.

# on the USB cable: 3 is for settings, 2 takes pictures for the screen
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="800a", ENV{AULA_F108_CABLE}="1"
ENV{AULA_F108_CABLE}=="1", ATTRS{bInterfaceNumber}=="02|03", TAG+="uaccess"

# through the 2.4G receiver: 3 is for settings
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="024f", ENV{AULA_F108_RECEIVER}="1"
ENV{AULA_F108_RECEIVER}=="1", ATTRS{bInterfaceNumber}=="03", TAG+="uaccess"
